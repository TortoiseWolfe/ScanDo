{
  "name": "scando",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild-check": "pnpm typecheck && pnpm lint && pnpm test && npx expo-doctor && npx expo export --platform ios --output-dir .expo-export-check --clear && rm -rf .expo-export-check",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "expo": "~53.0.0",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.8",
    "expo-file-system": "~18.1.11",
    "expo-gl": "~15.1.7",
    "expo-haptics": "~14.1.4",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.11",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "~0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.0",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0",
    "three": "^0.172.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.0.0",
    "@types/react": "^19.0.14",
    "@types/three": "^0.172.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^10.0.0",
    "expo-dev-client": "~5.2.4",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
